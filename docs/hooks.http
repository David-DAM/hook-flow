### GET Health of the server
GET {{baseUrl}}/health

> {%
    client.test("Server is healthy", function () {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

### GET Event
@id = 01a14e49-58a6-72ec-b0e6-b3cd883d0ccb
GET {{baseUrl}}/events/{{id}}

> {%
    client.test("Response is successful", function () {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

### GET Events
GET {{baseUrl}}/events

> {%
    client.test("Response is successful", function () {
        client.assert(response.status === 200, "Response status is not 200");
        client.assert(response.body != null, "Response is null")
    });
%}

### POST Event
POST {{baseUrl}}/events
Content-Type: application/json

{
  "type": "order.created",
  "destination_id": "dest_123",
  "data": {
    "order_id": "order_123",
    "amount": "49.90",
    "currency": "EUR"
  }
}


> {%
    client.test("Response is successful", function () {
        client.assert(response.status === 200, "Response status is not 200");
        client.assert(response.body != null, "Response is null")
    });
%}

